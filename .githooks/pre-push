#!/bin/bash
# A push to main deploys to production through .github/workflows/deploy.yml,
# and GitHub does not run tests. Running the local checks here is mandatory.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

PUSHES_MAIN=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        PUSHES_MAIN=1
    fi
done
[ "$PUSHES_MAIN" = "1" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
echo "pre-push: main deploys to production, running the local checks..."
{ [ -f node_modules/.package-lock.json ] && [ ! package-lock.json -nt node_modules/.package-lock.json ]; } || npm ci --silent --ignore-scripts
npm test
[ ! -f wrangler.toml ] || npx wrangler deploy --dry-run --outdir "$(mktemp -d)" >/dev/null
echo "pre-push: checks passed."
